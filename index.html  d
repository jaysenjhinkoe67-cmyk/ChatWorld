<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ChatWorld</title>
    <style>
        :root {
            --bg-color: #121212;
            --panel-bg: #1e1e1e;
            --text-color: #ffffff;
            --text-muted: #aaaaaa;
            --accent-color: #00ff66;
            --border-color: #333333;
            --bubble-me: #005c4b;
            --bubble-other: #202c33;
        }
        .light-mode {
            --bg-color: #f0f2f5;
            --panel-bg: #ffffff;
            --text-color: #000000;
            --text-muted: #666666;
            --accent-color: #00aa44;
            --border-color: #cccccc;
            --bubble-me: #d9fdd3;
            --bubble-other: #ffffff;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        body { background-color: var(--bg-color); color: var(--text-color); display: flex; flex-direction: column; height: 100vh; overflow: hidden; }
        header { background-color: var(--panel-bg); padding: 15px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; font-size: 20px; font-weight: bold; }
        .theme-btn, .admin-trigger { background: none; border: none; font-size: 20px; cursor: pointer; color: var(--text-color); padding: 5px; }
        #app-container { flex: 1; display: flex; flex-direction: column; overflow-y: auto; padding-bottom: 70px; position: relative; }
        .tab-content { display: none; padding: 15px; height: 100%; flex-direction: column; }
        .tab-content.active { display: flex; }
        
        /* Navigation */
        nav { position: fixed; bottom: 0; width: 100%; background-color: var(--panel-bg); border-top: 1px solid var(--border-color); display: flex; justify-content: space-around; padding: 10px 0; z-index: 100; }
        .nav-item { background: none; border: none; color: var(--text-muted); display: flex; flex-direction: column; align-items: center; font-size: 12px; cursor: pointer; width: 25%; }
        .nav-item.active { color: var(--accent-color); font-weight: bold; }
        .nav-item span { font-size: 20px; margin-bottom: 2px; }

        /* Badge */
        .badge { color: #1d9bf0; margin-left: 4px; font-size: 16px; display: inline-block; vertical-align: middle; }

        /* Setup Screen */
        .setup-screen { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 300px; padding: 30px; text-align: center; }
        .input-field { width: 100%; max-width: 300px; padding: 12px; margin: 10px 0; border-radius: 8px; border: 1px solid var(--border-color); background-color: var(--panel-bg); color: var(--text-color); font-size: 16px; }
        .btn { background-color: var(--accent-color); color: #000; font-weight: bold; border: none; padding: 12px 24px; border-radius: 8px; cursor: pointer; font-size: 16px; width: 100%; max-width: 300px; margin-top: 5px; }

        /* List Items */
        .item-card { background-color: var(--panel-bg); border: 1px solid var(--border-color); padding: 15px; border-radius: 10px; margin-bottom: 10px; display: flex; align-items: center; justify-content: space-between; width: 100%; }
        .item-info { display: flex; align-items: center; gap: 12px; }
        .avatar { width: 45px; height: 45px; border-radius: 50%; background-color: #555; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 18px; }
        
        /* Chat View */
        .chat-view { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: var(--bg-color); z-index: 200; flex-direction: column; }
        .chat-header { background-color: var(--panel-bg); padding: 15px; display: flex; align-items: center; gap: 15px; font-weight: bold; border-bottom: 1px solid var(--border-color); }
        .back-btn { background: none; border: none; color: var(--text-color); font-size: 24px; cursor: pointer; }
        .message-area { flex: 1; padding: 15px; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; }
        .msg { max-width: 75%; padding: 10px 14px; border-radius: 12px; font-size: 15px; line-height: 1.4; word-break: break-word; }
        .msg.me { background-color: var(--bubble-me); align-self: flex-end; }
        .msg.other { background-color: var(--bubble-other); align-self: flex-start; }
        .chat-input-bar { padding: 10px; background-color: var(--panel-bg); display: flex; gap: 10px; align-items: center; border-top: 1px solid var(--border-color); }
        .chat-input { flex: 1; padding: 10px; border-radius: 20px; border: 1px solid var(--border-color); background-color: var(--bg-color); color: var(--text-color); }
        .round-btn { background-color: var(--accent-color); border: none; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 18px; cursor: pointer; }

        /* Admin Modal */
        .admin-modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.8); z-index: 300; padding: 20px; justify-content: center; align-items: center; }
        .admin-content { background-color: var(--panel-bg); border-radius: 12px; padding: 20px; width: 100%; max-width: 400px; max-height: 80%; overflow-y: auto; border: 1px solid var(--border-color); }
    </style>
</head>
<body>

    <header>
        <span id="app-title">ChatWorld</span>
        <div>
            <button class="admin-trigger" onclick="openAdmin()">⚙️</button>
            <button class="theme-btn" onclick="toggleTheme()">🌓</button>
        </div>
    </header>

    <div id="app-container">
        <!-- Setup Screen -->
        <div id="setup-screen" class="setup-screen">
            <h2>Welkom bij ChatWorld!</h2>
            <p style="color: var(--text-muted); margin-bottom: 20px;">Kies een naam en maak je profiel aan.</p>
            <input type="text" id="username-input" class="input-field" placeholder="Jouw Naam...">
            <button class="btn" onclick="saveProfile()">Starten</button>
        </div>

        <!-- Tab 1: Kanalen -->
        <div id="tab-kanalen" class="tab-content">
            <button class="btn" style="margin-bottom: 15px;" onclick="createChannel()">➕ Nieuw Kanaal Maken</button>
            <div id="channels-list"></div>
        </div>

        <!-- Tab 2: Chats -->
        <div id="tab-chats" class="tab-content">
            <button class="btn" style="margin-bottom: 15px;" onclick="addContact()">👤 Contact Toevoegen via ID</button>
            <div id="chats-list"></div>
        </div>

        <!-- Tab 3: Updates -->
        <div id="tab-updates" class="tab-content">
            <div id="updates-list"></div>
        </div>

        <!-- Tab 4: Instellingen -->
        <div id="tab-instellingen" class="tab-content">
            <div class="item-card" style="flex-direction: column; align-items: flex-start; gap: 10px;">
                <div><strong>Mijn Uniek ID:</strong> <span id="my-id-display" style="color: var(--accent-color); font-weight: bold;">--------</span></div>
                <div><strong>Mijn Naam:</strong> <span id="my-name-display">---</span> <span id="my-badge-display"></span></div>
            </div>
            <button class="btn" style="margin-bottom: 10px;" onclick="editName()">✏️ Naam Aanpassen</button>
            <button class="btn" style="background-color: #1d9bf0; color: #fff;" onclick="requestVerification()">🌀 Verificatiebadge Aanvragen</button>
        </div>
    </div>

    <!-- Active Chat View overlay -->
    <div id="chat-view" class="chat-view">
        <div class="chat-header">
            <button class="back-btn" onclick="closeChat()">⬅️</button>
            <div class="avatar" id="chat-avatar">?</div>
            <span id="chat-title">Chatting</span>
        </div>
        <div class="message-area" id="message-area"></div>
        <div class="chat-input-bar">
            <input type="text" id="chat-input" class="chat-input" placeholder="Typ een bericht...">
            <button class="round-btn" onclick="sendMessage(false)">🕊️</button>
            <button class="round-btn" style="background-color: #ff3333;" onclick="sendMessage(true)" title="Verdwijnend bericht (10s)">⏱️</button>
        </div>
    </div>

    <!-- Maker Admin Modal -->
    <div id="admin-modal" class="admin-modal">
        <div class="admin-content">
            <h3>Maker Beheer</h3>
            <hr style="margin: 10px 0; border-color: var(--border-color);">
            <h4>Plaats Nieuwe Update:</h4>
            <input type="text" id="admin-update-input" class="input-field" placeholder="Typ updatebericht...">
            <button class="btn" style="margin-bottom: 20px;" onclick="postAdminUpdate()">Post Update</button>
            
            <h4>Verificatie Aanvragen:</h4>
            <div id="admin-requests-list" style="margin-top: 10px; color: var(--text-muted);">Geen lopende aanvragen.</div>
            <button class="btn" style="background-color: #555; margin-top: 15px;" onclick="closeAdmin()">Sluiten</button>
        </div>
    </div>

    <nav id="main-nav" style="display: none;">
        <button class="nav-item active" onclick="switchTab('kanalen', this)"><span>📺</span>Kanalen</button>
        <button class="nav-item" onclick="switchTab('chats', this)"><span>💬</span>Chats</button>
        <button class="nav-item" onclick="switchTab('updates', this)"><span>📢</span>Updates</button>
        <button class="nav-item" onclick="switchTab('instellingen', this)"><span>⚙️</span>Opties</button>
    </nav>

    <script>
        let currentUser = JSON.parse(localStorage.getItem('cw_user')) || null;
        let myChannels = JSON.parse(localStorage.getItem('cw_channels')) || [];
